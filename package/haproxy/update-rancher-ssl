#!/bin/bash
set -e

CA_ROOT="/var/lib/rancher/etc/ssl/ca.crt"
SYSTEM_CA_DIR="/usr/share/ca-certificates/rancher"
SYSTEM_CA="$SYSTEM_CA_DIR/ca.crt"
USER_CA_DIR="${XDG_RUNTIME_DIR:-/tmp}/rancher-ca"
USER_CA="$USER_CA_DIR/ca-certificates.crt"
JKS_STORE="${JAVA_CACERTS:-}"
JAVA_STORE_PASS=${JAVA_STORE_PASS:=changeit}

if [ -z "$JKS_STORE" ]; then
  for candidate in \
    "${JAVA_HOME:-}/jre/lib/security/cacerts" \
    "${JAVA_HOME:-}/lib/security/cacerts" \
    "/etc/ssl/certs/java/cacerts"; do
    if [ -f "$candidate" ]; then
      JKS_STORE="$candidate"
      break
    fi
  done
fi

if [ ! -f "$CA_ROOT" ]; then
  exit 0
fi

if [ "$(id -u)" = "0" ]; then
  if [ ! -e "$SYSTEM_CA" ]; then
    echo Adding ca.crt to Certs. >&2
    mkdir -p "$SYSTEM_CA_DIR"
    cp "$CA_ROOT" "$SYSTEM_CA"
    if ! grep -qxF rancher/ca.crt /etc/ca-certificates.conf; then
      echo rancher/ca.crt >> /etc/ca-certificates.conf
    fi
    update-ca-certificates >&2
  fi

  if [ -n "${CATTLE_RANCHER_SERVER_VERSION:-}" ] && [ -n "$JKS_STORE" ]; then
    if keytool -list -keystore "$JKS_STORE" -alias rancher_ca -storepass "$JAVA_STORE_PASS" >/dev/null 2>&1; then
        keytool -delete -alias rancher_ca -storepass "$JAVA_STORE_PASS" -keystore "$JKS_STORE" -noprompt
    fi
    keytool -import -trustcacerts \
        -file "$CA_ROOT" -alias rancher_ca \
        -keystore "$JKS_STORE" -storepass "$JAVA_STORE_PASS" \
        -noprompt
  fi
  exit 0
fi

mkdir -p "$USER_CA_DIR"
cat /etc/ssl/certs/ca-certificates.crt "$CA_ROOT" > "$USER_CA"
printf '%s\n' "$USER_CA"
