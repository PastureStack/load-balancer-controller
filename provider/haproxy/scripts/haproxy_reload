#!/bin/bash
set -euo pipefail

config=${1:?haproxy config path required}
action=${2:-reload}
pidfile=${HAPROXY_PIDFILE:-/run/haproxy/haproxy.pid}
rsyslog_pid=${HAPROXY_RSYSLOG_PIDFILE:-NONE}
rsyslog_config=${HAPROXY_RSYSLOG_CONFIG:-/etc/rsyslog.d/49-pasturestack-haproxy.conf}
new_config=/etc/haproxy/haproxy_new.cfg
cert_new=/etc/haproxy/certs/new
cert_current=/etc/haproxy/certs/current

ensure_dirs() {
    mkdir -p "$(dirname "$pidfile")" "$cert_new" "$cert_current" /var/log/haproxy
}

ensure_rsyslog() {
    if ! pgrep -x rsyslogd >/dev/null 2>&1; then
        if [ "$rsyslog_pid" != NONE ]; then
            rm -f "$rsyslog_pid"
        fi
        rsyslogd -i "$rsyslog_pid" -f "$rsyslog_config" >/dev/null
    fi
}

running_pids() {
    [ -s "$pidfile" ] || return 0
    while read -r pid; do
        [ -n "$pid" ] || continue
        if kill -0 "$pid" >/dev/null 2>&1; then
            printf '%s\n' "$pid"
        fi
    done < "$pidfile"
}

start_or_reload_haproxy() {
    local cfg=$1
    ensure_dirs
    if [ ! -s "$cfg" ]; then
        echo "haproxy config $cfg is empty; skipping $action"
        return 0
    fi
    haproxy -c -f "$cfg"
    ensure_rsyslog
    mapfile -t old_pids < <(running_pids)
    if [ "${#old_pids[@]}" -gt 0 ]; then
        haproxy -f "$cfg" -p "$pidfile" -sf "${old_pids[@]}"
    else
        haproxy -f "$cfg" -p "$pidfile"
    fi
}

cleanup_temp_certs() {
    ensure_dirs
    rm -f "$cert_new"/*
}

copy_data() {
    ensure_dirs
    rm -f "$cert_current"/*
    cp -r "$cert_new"/. "$cert_current"
    cleanup_temp_certs
    cp -r "$new_config" "$config"
}

reapply() {
    copy_data
    start_or_reload_haproxy "$config"
}

apply_config() {
    ensure_dirs
    if [ "$action" = "start" ]; then
        echo "starting haproxy"
        start_or_reload_haproxy "$config"
    elif ! cmp -s "$config" "$new_config"; then
        echo "reloading haproxy config with the new config changes"
        reapply
    elif ! diff -q "$cert_new" "$cert_current" >/dev/null 2>&1; then
        echo "reloading haproxy config with the certificates changes"
        reapply
    else
        cleanup_temp_certs
    fi
}

apply_config
