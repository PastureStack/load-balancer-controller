#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${root_dir}"

require_text() {
    grep -Fq -- "$2" "$1" || { printf 'Missing required pin in %s: %s\n' "$1" "$2" >&2; exit 1; }
}

[[ -f go.mod && -f go.sum && -f vendor/modules.txt ]]
go mod verify
go list -mod=vendor ./... >/dev/null
require_text go.mod 'go 1.27'
require_text go.mod 'github.com/gorilla/websocket v1.5.3'
require_text go.mod 'github.com/sirupsen/logrus v1.10.2'
require_text go.mod 'github.com/urfave/cli/v3 v3.11.0'
require_text go.mod 'golang.org/x/sys v0.47.0'
require_text Dockerfile.dapper 'ARG GO_VERSION=1.27.0'
require_text Dockerfile.dapper 'FROM docker:29.7.2-cli@sha256:000bb62ff495f986c9f5578eb67cc2cb98b91138eda81d7762d5371eb8a497fe AS docker-cli'
require_text package/haproxy/Dockerfile 'ARG HAPROXY_VERSION=3.4.3'
require_text package/haproxy/Dockerfile 'ARG ALPINE_IMAGE=docker.io/library/alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b'
require_text package/haproxy/Dockerfile 'TARGET=linux-musl'
require_text package/haproxy/Dockerfile '"tini=${ALPINE_TINI_VERSION}"'
require_text .github/workflows/security-release-gate.yml 'TRIVY_IMAGE: ghcr.io/aquasecurity/trivy:0.74.0@sha256:62b1e65e8869bc4b4c6aa4fa2b21595256c7c2f6018a9d9ad61caf87187c1969'

for obsolete in controller/kubernetes controller/rancherglb provider/rancher package/rancher examples trash.conf vendor.lock; do
    [[ ! -e "${obsolete}" ]] || { printf 'Obsolete compatibility surface remains: %s\n' "${obsolete}" >&2; exit 1; }
done
if grep -R -n -E 'k8s\.io/kubernetes|github\.com/rancher/(go-rancher|go-rancher-metadata|event-subscriber|log)' \
    --include='*.go' --exclude-dir=.git --exclude-dir=vendor .; then
    printf 'An abandoned runtime dependency remains in source.\n' >&2
    exit 1
fi
if grep -R -n -E 'Verify-(Peer|Host)[[:space:]]+"?false|trusted=yes|--insecure|--no-check-certificate|AllowUnauthenticated[[:space:]]+"true"' \
    Dockerfile.dapper package/haproxy/Dockerfile .github/workflows; then
    printf 'TLS or package-signature verification is disabled.\n' >&2
    exit 1
fi
while IFS= read -r action_use; do
    [[ "${action_use}" =~ uses:[[:space:]]+[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*@[0-9a-f]{40}([[:space:]]|$) ]] || {
        printf 'GitHub Action is not pinned to a commit SHA: %s\n' "${action_use}" >&2
        exit 1
    }
done < <(grep -R -h -E '^[[:space:]]+uses:' .github/workflows)
printf 'Supply-chain pins passed for the maintained HAProxy runtime.\n'
