#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${root_dir}"

go mod verify
go list -mod=vendor ./... >/dev/null
go vet -mod=vendor ./...

unformatted="$(find . -name '*.go' -not -path './.git/*' -not -path './vendor/*' -print0 \
    | xargs -0 -r gofmt -l -s)"
if [[ -n "${unformatted}" ]]; then
    printf '%s\n' "${unformatted}" >&2
    exit 1
fi

./scripts/log-safety-test
./scripts/supply-chain-check
printf 'Validation passed: modules, vendor, vet, formatting, log safety, and supply-chain pins.\n'
