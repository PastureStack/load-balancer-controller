#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${script_dir}/.."

command -v go >/dev/null
command -v gofmt >/dev/null

echo Running validation

PACKAGES=". $(find -name '*.go' | xargs -I{} dirname {} |  cut -f2 -d/ | sort -u | grep -Ev '(^\.$|.git|vendor|bin)' | sed -e 's!^!./!' -e 's!$!/...!')"

echo Running: go vet
go vet ${PACKAGES}
printf "%s\n" "Running supported validation: go vet and gofmt."
echo Running: gofmt
unformatted="$(find . -name '*.go' -not -path './.git/*' -not -path './vendor/*' -print0 \
    | xargs -0 -r gofmt -l -s)"
if [[ -n "${unformatted}" ]]; then
    printf '%s\n' "${unformatted}" >&2
    exit 1
fi

echo Running: vendor lock tests
./scripts/vendor-lock-test

echo Running: vendored license tests
./scripts/vendor-licenses-test

echo Running: supply-chain legitimate and malicious-boundary tests
./scripts/supply-chain-check-test

echo Running: OpenVEX legitimate and malicious-boundary tests
./scripts/openvex-test

echo Running: source SBOM tests
./scripts/source-sbom-test
