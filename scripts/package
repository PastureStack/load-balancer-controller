#!/usr/bin/env bash
set -euo pipefail

ARCH=${ARCH:?"ARCH not set"}
suffix=""
[[ "${ARCH}" == "amd64" ]] || suffix="_${ARCH}"

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root_dir="$(cd "${script_dir}/.." && pwd)"
source "${script_dir}/version"
cd "${root_dir}"

mkdir -p dist
tag=${TAG:-${VERSION}${suffix}}
repo=${REPO:-ghcr.io/pasturestack}
image_prefix=${IMAGE_PREFIX:-}
source_revision=${SOURCE_REVISION:-$(git rev-parse HEAD)}
source_epoch=${SOURCE_DATE_EPOCH:-$(git show -s --format=%ct HEAD)}
source_created_at="$(date -u -d "@${source_epoch}" '+%Y-%m-%dT%H:%M:%SZ')"

[[ -s bin/lb-controller ]] || scripts/build

context_root="${root_dir}/dist/package-contexts/haproxy"
license_bundle="${root_dir}/dist/legal/third-party-licenses"
case "${context_root}" in "${root_dir}"/dist/*) ;; *) exit 64 ;; esac
rm -rf "${root_dir}/dist/package-contexts" "${root_dir}/dist/legal"
mkdir -p "${context_root}" "${license_bundle}"
scripts/vendor-licenses "${license_bundle}"

while IFS= read -r -d '' tracked_file; do
    relative_path="${tracked_file#package/haproxy/}"
    mkdir -p "${context_root}/$(dirname "${relative_path}")"
    cp -a "${root_dir}/${tracked_file}" "${context_root}/${relative_path}"
done < <(git ls-files -z package/haproxy)

cp -a bin/lb-controller "${context_root}/lb-controller"
cp -a LICENSE ORIGIN.md "${context_root}/"
cp -a "${license_bundle}" "${context_root}/third-party-licenses"
cp -a provider/haproxy/scripts "${context_root}/scripts"
cp -a provider/haproxy/config "${context_root}/config"
find "${context_root}" -exec touch -h -d "@${source_epoch}" {} +

image="${repo}/${image_prefix}load-balancer-service:${tag}"
DOCKER_BUILDKIT="${DOCKER_BUILDKIT:-1}" docker build \
    --network "${DOCKER_BUILD_NETWORK:-host}" \
    --build-arg PASTURESTACK_IMAGE_VERSION="${tag}" \
    --build-arg SOURCE_REVISION="${source_revision}" \
    --label "org.opencontainers.image.created=${source_created_at}" \
    -t "${image}" "${context_root}"
printf '%s\n' "${image}" > dist/images
printf 'Built %s\n' "${image}"
