#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
output_dir=${1:?"usage: vendor-licenses OUTPUT_DIRECTORY"}
[[ -f "${root_dir}/vendor/modules.txt" && ! -L "${root_dir}/vendor/modules.txt" ]]
mkdir -p "${output_dir}"
[[ -z "$(find "${output_dir}" -mindepth 1 -print -quit)" ]]

manifest="${output_dir}/manifest.tsv"
printf 'module\tversion\tlicense_path\tsha256\n' > "${manifest}"
while IFS=$'\t' read -r module version; do
    source_dir="${root_dir}/vendor/${module}"
    [[ -d "${source_dir}" && ! -L "${source_dir}" ]]
    found=0
    while IFS= read -r -d '' license; do
        relative="${license#${source_dir}/}"
        destination="${output_dir}/${module}/${relative}"
        mkdir -p "$(dirname "${destination}")"
        install -m 0644 "${license}" "${destination}"
        digest="$(sha256sum "${destination}" | awk '{print $1}')"
        printf '%s\t%s\t%s\t%s\n' "${module}" "${version}" "${relative}" "${digest}" >> "${manifest}"
        found=$((found + 1))
    done < <(find "${source_dir}" -maxdepth 1 -type f \( -iname 'LICENSE*' -o -iname 'NOTICE*' -o -iname 'COPYING*' \) -print0 | LC_ALL=C sort -z)
    [[ "${found}" -gt 0 ]] || { printf 'No vendored license for %s\n' "${module}" >&2; exit 1; }
done < <(awk '/^# [^=]/ { print $2 "\t" $3 }' "${root_dir}/vendor/modules.txt")

[[ "$(wc -l < "${manifest}")" -eq 5 ]]
printf 'Vendored license bundle created for 4 modules.\n'
