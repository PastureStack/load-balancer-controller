#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
temporary_dir="$(mktemp -d)"
trap 'rm -rf "${temporary_dir}"' EXIT

"${root_dir}/scripts/vendor-lock" --check

awk 'BEGIN { FS=OFS="\t" } NR == 2 { first=substr($3,1,1); $3=(first == "0" ? "1" : "0") substr($3,2) } { print }' \
    "${root_dir}/vendor.lock" > "${temporary_dir}/tampered.lock"
if "${root_dir}/scripts/vendor-lock" --check "${temporary_dir}/tampered.lock" >/dev/null 2>&1; then
    printf 'Tampered vendor content hash was accepted.\n' >&2
    exit 1
fi

sed '2d' "${root_dir}/vendor.lock" > "${temporary_dir}/missing.lock"
if "${root_dir}/scripts/vendor-lock" --check "${temporary_dir}/missing.lock" >/dev/null 2>&1; then
    printf 'A vendor lock with a missing module was accepted.\n' >&2
    exit 1
fi

printf '../outside v1.0.0\n' > "${temporary_dir}/traversal.conf"
if VENDOR_MANIFEST="${temporary_dir}/traversal.conf" \
    "${root_dir}/scripts/vendor-lock" --print >/dev/null 2>&1; then
    printf 'A path-traversal vendor module was accepted.\n' >&2
    exit 1
fi

if GIT_DIR="${temporary_dir}/missing-git-directory" \
    "${root_dir}/scripts/vendor-lock" --print >/dev/null 2>&1; then
    printf 'Vendor hashing accepted an unavailable Git object database.\n' >&2
    exit 1
fi

printf 'Vendor lock legitimate and malicious-boundary tests passed.\n'
