#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
grep -Fq 'input = strings.ReplaceAll(input, "\r", `\r`)' "${root_dir}/utils/log_safety.go"
grep -Fq 'return strings.ReplaceAll(input, "\n", `\n`)' "${root_dir}/utils/log_safety.go"
grep -Fq 'utils.SanitizeLogText(err.Error())' "${root_dir}/controller/rancher/rancher.go"
if grep -R -n -E '(failed|Failed|Error forming) (to )?(apply|cleanup|get|form).*lb config.*%[#v+]' \
    "${root_dir}/controller/rancher"; then
    printf 'An unescaped load-balancer configuration error can forge log records.\n' >&2
    exit 1
fi
printf 'Log-safety source boundary passed.\n'
